# Address of the CreditSentinel scoring service, as the *browser* will reach it.
# Read per request on the server and handed to the client (lib/config.tsx), so the
# same image works in any environment. The service must list this console's own
# origin in CS_CORS_ALLOW_ORIGINS.
#
# Local (uvicorn on :8000):     http://localhost:8000
# Docker Compose (host mapping): http://localhost:8080
CS_API_BASE_URL=http://localhost:8080
